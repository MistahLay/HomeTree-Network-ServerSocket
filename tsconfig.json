{
  "compilerOptions": {
    "target": "ESNext",                                  
    "module": "commonjs",                                
    "allowJs": true,                                 
    "outDir": "build",                                   
    "esModuleInterop": true,                             
    "forceConsistentCasingInFileNames": true,            
    "strict": true,                                   
    "skipLibCheck": true,                                 
  }
}
